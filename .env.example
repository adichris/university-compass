# Database. Leave unset locally to use the SQLite file unichecker.db.
#   PostgreSQL (alwaysdata):   DATABASE_URL=postgresql://<user>:<password>@postgresql-<account>.alwaysdata.net:5432/<database>
#   SQLite file (VPS):         DATABASE_URL=file:/home/<account>/data/campuscompass.db
#   Turso (Vercel):            DATABASE_URL=libsql://<db>.turso.io  + TURSO_AUTH_TOKEN
DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
