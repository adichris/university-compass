# Database. Leave unset locally to use the SQLite file unichecker.db.
#   PostgreSQL (alwaysdata):   DATABASE_URL=postgresql://<user>:<password>@postgresql-<account>.alwaysdata.net:5432/<database>
#   SQLite file (VPS):         DATABASE_URL=file:/home/<account>/data/university-compass.db
#   Turso (Vercel):            DATABASE_URL=libsql://<db>.turso.io  + TURSO_AUTH_TOKEN
DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: secret mixed into the daily anonymous visitor ID
STATS_SALT=
# CheckResultGH Partner API (results checker sales). Server-side only - never NEXT_PUBLIC_.
# Use a crg_test_ key first; a crg_live_ key charges your partner wallet.
CRG_KEY=
CRG_SECRET=
